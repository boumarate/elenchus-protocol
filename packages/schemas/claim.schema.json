{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elenchus.example/schemas/claim.schema.json",
  "title": "Claim",
  "description": "Metadata for a manuscript registered on Elenchus. The manuscript itself lives off-chain (IPFS); only its hash and CID are anchored on-chain.",
  "type": "object",
  "required": ["title", "abstract", "authors", "fields", "manuscript"],
  "additionalProperties": false,
  "properties": {
    "title": { "type": "string", "minLength": 5, "maxLength": 300 },
    "abstract": { "type": "string", "minLength": 50, "maxLength": 5000 },
    "authors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "orcid": { "type": "string", "pattern": "^\\d{4}-\\d{4}-\\d{4}-\\d{3}[\\dX]$" },
          "stellarAddress": { "type": "string", "pattern": "^G[A-Z2-7]{55}$" }
        }
      }
    },
    "fields": {
      "type": "array",
      "minItems": 1,
      "description": "Subject tags used for examiner matching.",
      "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }
    },
    "manuscript": {
      "type": "object",
      "required": ["cid", "sha256"],
      "additionalProperties": false,
      "properties": {
        "cid": { "type": "string", "description": "IPFS CID of the manuscript file." },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$", "description": "Hex SHA-256 of the manuscript bytes. This is the on-chain claim id." },
        "mediaType": { "type": "string", "default": "application/pdf" }
      }
    },
    "dataAvailability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "datasetCids": { "type": "array", "items": { "type": "string" } },
        "codeRepository": { "type": "string", "format": "uri" },
        "statement": { "type": "string" }
      }
    },
    "conflictsOfInterest": {
      "type": "array",
      "description": "Stellar addresses or names the author asks to exclude as examiners.",
      "items": { "type": "string" }
    }
  }
}
